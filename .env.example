# ============================================================
# Newsletter Studio - configurazione locale.
# Al primo avvio l'app copia questo file in `.env`.
# ============================================================

# Percorso del database SQLite (relativo alla cartella del progetto)
DATABASE_PATH=data/newsletter.db

# Interfaccia e porta del server web locale
HOST=127.0.0.1
PORT=8090

# Aprire il browser all'avvio (true/false)
SHOW_BROWSER=true
